---
// Pagina CV nella lingua della pagina. Il PDF si ottiene dalla pagina stessa, con la stampa del browser:
// gli stili per il PDF sono in fondo a src/styles/global.css (@media print).
import ProfileLayout from '../layouts/ProfileLayout.astro';
import CareerList from './CareerList.astro';
import { AUTHOR } from '../consts';
import { CV } from '../data/cv';
import { getLang, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const cv = CV[lang];
---

<ProfileLayout title={t.cv.title} description={t.cv.description}>
  <!-- Intestazione del PDF: a schermo nome e contatti sono nel profilo a lato -->
  <div class="print-only cv-print-header">
    <img class="cv-print-photo" src={AUTHOR.avatar} alt={AUTHOR.name} />
    <div>
      <p class="cv-print-name">{AUTHOR.name}</p>
      <p>{t.bio} · {t.location}</p>
      <p>{AUTHOR.email} · {AUTHOR.phone}</p>
      <p>{AUTHOR.linkedin.replace('https://www.', '').replace(/\/$/, '')}</p>
    </div>
  </div>

  <h1>{t.cv.title}</h1>

  <div class="no-print">
    <p>{t.cv.intro}</p>
    <p>
      <button class="button" type="button" data-print-cv={`Giancarlo_Ronci_CV_${lang.toUpperCase()}`}>
        {t.cv.download}
      </button>
    </p>
  </div>

  <h2>{t.cv.summary}</h2>
  {cv.summary.map((paragraph) => <p>{paragraph}</p>)}

  <h2>{t.cv.skills}</h2>
  <ul>
    {
      cv.expertise.map((item) => (
        <li>
          <strong>{item.title}</strong>: {item.description}
        </li>
      ))
    }
  </ul>
  <ul class="tags tags--large">
    {cv.skills.map((skill) => <li>{skill}</li>)}
  </ul>

  <h2>{t.cv.experience}</h2>
  <CareerList entries={cv.experience} />

  <h2>{t.cv.education}</h2>
  <CareerList entries={cv.education} />

  <div class="no-print">
    <h2>{t.cv.contact}</h2>
    <ul>
      <li>LinkedIn: <a href={AUTHOR.linkedin}>{AUTHOR.name}</a></li>
      <li>GitHub: <a href={AUTHOR.github}>GiancarloRonci</a></li>
      <li>Email: <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a></li>
      <li>{t.cv.phone}: <a href={`tel:${AUTHOR.phone.replaceAll(' ', '')}`}>{AUTHOR.phone}</a></li>
    </ul>
  </div>
</ProfileLayout>

<script>
  // Il titolo del documento diventa il nome proposto per il file PDF
  const button = document.querySelector<HTMLButtonElement>('[data-print-cv]');

  button?.addEventListener('click', () => {
    const title = document.title;
    document.title = button.dataset.printCv ?? title;
    window.addEventListener('afterprint', () => (document.title = title), { once: true });
    window.print();
  });
</script>
