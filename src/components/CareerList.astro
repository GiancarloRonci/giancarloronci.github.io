---
// Elenco di esperienze o formazione, dai dati in src/data/cv.ts.
// Con `compact` (home) mostra solo periodo, titolo e descrizione.
import CareerItem from './CareerItem.astro';
import type { CvEntry } from '../data/cv';

interface Props {
  entries: CvEntry[];
  compact?: boolean;
}

const { entries, compact = false } = Astro.props;
---

<div class="career-list">
  {
    entries.map((entry) => (
      <CareerItem period={entry.period} title={entry.title} logo={entry.logo} logoAlt={entry.logoAlt}>
        {entry.description && <p>{entry.description}</p>}
        {!compact && entry.highlights && (
          <ul>
            {entry.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        )}
        {!compact && entry.technologies && (
          <ul class="tags">
            {entry.technologies.map((technology) => (
              <li>{technology}</li>
            ))}
          </ul>
        )}
      </CareerItem>
    ))
  }
</div>
