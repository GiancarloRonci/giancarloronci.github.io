---
// Pagina di una categoria: descrizione e articoli pubblicati nella lingua della pagina
import ProfileLayout from '../layouts/ProfileLayout.astro';
import PostList from './PostList.astro';
import { getCategory, type CategorySlug } from '../data/categories';
import { LANGUAGES, localizePath, useTranslations, type Lang } from '../i18n/ui';
import { getCategoryUrl, getUsedCategories } from '../lib/posts';

interface Props {
  slug: CategorySlug;
  lang: Lang;
}

const { slug, lang } = Astro.props;
const t = useTranslations(lang);
const category = getCategory(slug);
const posts = (await getUsedCategories(lang)).find((used) => used.slug === slug)?.posts ?? [];

// Nell'altra lingua la stessa categoria può non avere articoli: in quel caso si torna al blog
const alternates: Partial<Record<Lang, string>> = {};
for (const code of Object.keys(LANGUAGES) as Lang[]) {
  if (code === lang) continue;
  const used = (await getUsedCategories(code)).some((other) => other.slug === slug);
  alternates[code] = used ? getCategoryUrl(slug, code) : localizePath('/posts/', code);
}
---

<ProfileLayout title={category.label[lang]} description={category.description[lang]} alternates={alternates}>
  <p class="category-page__kicker">{t.category}</p>
  <h1>{category.label[lang]}</h1>
  <p>{category.description[lang]}</p>
  <PostList posts={posts} />
  <p class="post__back"><a href={localizePath('/posts/', lang)}>{t.allPosts}</a></p>
</ProfileLayout>
