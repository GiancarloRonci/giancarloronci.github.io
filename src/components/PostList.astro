---
import type { CollectionEntry } from 'astro:content';
import { getLang, useTranslations } from '../i18n/ui';
import { formatDate, getPostUrl } from '../lib/posts';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <a class="post-list__title" href={getPostUrl(post)}>
          {post.data.title}
        </a>
        {post.data.draft && <span class="badge">{t.draft}</span>}
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
        <p>{post.data.description}</p>
      </li>
    ))
  }
</ul>
