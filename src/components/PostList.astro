---
import type { CollectionEntry } from 'astro:content';
import CategoryLinks from './CategoryLinks.astro';
import { getLang, useTranslations } from '../i18n/ui';
import { formatDate, getPostUrl } from '../lib/posts';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li class:list={{ 'post-list__item--cover': post.data.cover }}>
        {post.data.cover && (
          <a class="post-list__cover" href={getPostUrl(post)} tabindex="-1" aria-hidden="true">
            <img src={post.data.cover.src} alt="" width="1200" height="630" loading="lazy" />
          </a>
        )}
        <div>
          <a class="post-list__title" href={getPostUrl(post)}>
            {post.data.title}
          </a>
          {post.data.draft && <span class="badge">{t.draft}</span>}
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
          <p>{post.data.description}</p>
          <CategoryLinks categories={post.data.categories} lang={lang} />
        </div>
      </li>
    ))
  }
</ul>
