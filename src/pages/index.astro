---
import ProfileLayout from '../layouts/ProfileLayout.astro';
import CareerItem from '../components/CareerItem.astro';
import PostList from '../components/PostList.astro';
import { AUTHOR } from '../consts';
import { getPublishedPosts } from '../lib/posts';

const latestPosts = (await getPublishedPosts('en')).slice(0, 5);
---

<ProfileLayout>
  <h1>Giancarlo Ronci</h1>

  <p>Italy · Milan / Rome area</p>

  <p>
    For coaching, advisory, speaking or exchanges on Data, Analytics and AI, feel free to reach out on
    <a href={AUTHOR.linkedin}>LinkedIn</a>.
  </p>

  <h2>Bio</h2>

  <p>
    Giancarlo Ronci is a senior data leader and advisor with extensive experience in data management, data
    warehousing, analytics engineering and modern cloud data platforms.
  </p>
  <p>
    He works at the intersection of business, architecture and delivery, helping organizations turn data into
    concrete operating capabilities. His background combines hands-on experience in data warehouse design,
    streaming and batch pipelines, data governance, data quality and analytics enablement.
  </p>
  <p>
    His approach is pragmatic: connect strategy, operating model, architecture and execution to generate measurable
    business value.
  </p>

  <h2>Main areas of activity</h2>

  <ul>
    <li>Building and evolving modern data platforms</li>
    <li>Defining pragmatic Data Strategy and operating models</li>
    <li>Improving Data Governance and Data Quality capabilities</li>
    <li>Enabling Business Intelligence, Advanced Analytics and AI adoption</li>
    <li>Coaching professionals and teams on Data &amp; Analytics leadership</li>
  </ul>

  <h2>Professional Career</h2>

  <div class="career-list">
    <CareerItem
      period="Current"
      title="Head of Data Management & Data Warehouse · Soldo · Italy"
      logo="/assets/images/companies/soldo.svg"
      logoAlt="Soldo logo"
    >
      <p>
        Leading initiatives on data platform evolution, data warehouse architecture and analytics enablement in a
        fintech environment.
      </p>
      <ul>
        <li>Modern cloud data architecture and data warehouse evolution</li>
        <li>Data engineering, orchestration and near real-time data pipelines</li>
        <li>Data governance, data quality and analytical data exposure</li>
      </ul>
    </CareerItem>

    <CareerItem period="Advisory" title="Data & Analytics Coach & Advisor">
      <p>
        Supporting professionals, managers and organizations in strengthening their data capabilities through
        structured coaching and advisory.
      </p>
      <ul>
        <li>Data Strategy and target operating model</li>
        <li>Coaching on data leadership, architecture and analytics maturity</li>
        <li>Practical guidance on BI, ML and AI adoption paths</li>
      </ul>
    </CareerItem>

    <CareerItem period="Focus areas" title="Data Platform, Governance and Analytics Transformation">
      <p>
        Over the years, Giancarlo has worked across different layers of the data value chain, from modeling and
        warehousing to analytics delivery and organizational enablement.
      </p>
      <ul>
        <li>Enterprise data warehouse and dimensional / analytical modeling</li>
        <li>Cloud services and ecosystem integration</li>
        <li>Business-facing analytics and data-driven decision support</li>
      </ul>
    </CareerItem>
  </div>

  <h2>Education</h2>

  <div class="career-list">
    <CareerItem period="Academic background" title="Engineering, Data and Technology background">
      <p>
        Academic and professional development centered on technology, data systems and analytical problem solving,
        continuously expanded through practical work on platforms, architectures and applied analytics.
      </p>
    </CareerItem>

    <CareerItem period="Continuous learning" title="Ongoing professional development">
      <p>
        Continuous focus on cloud data platforms, data engineering, data governance, machine learning, AI and
        managerial growth in Data &amp; Analytics leadership.
      </p>
    </CareerItem>
  </div>

  <h2>Selected Articles</h2>

  <p>A selection of articles and reflections on data platforms, governance, analytics strategy and AI adoption.</p>

  {
    latestPosts.length > 0 ? (
      <PostList posts={latestPosts} />
    ) : (
      <ul>
        <li>Modern Data Platform: from architecture to operating model</li>
        <li>Data Warehouse, Data Lake and Lakehouse: when each one makes sense</li>
        <li>Data Governance in practice: how to move from theory to execution</li>
        <li>Near real-time analytics: opportunities, trade-offs and architecture choices</li>
        <li>AI adoption in organizations: where value is real and where it is not</li>
      </ul>
    )
  }

  <p>You can find more articles in the <a href="/posts/">Articles</a> section.</p>

  <h2>Core expertise</h2>

  <ul>
    <li>Data Strategy</li>
    <li>Data Management</li>
    <li>Data Warehouse</li>
    <li>Data Engineering</li>
    <li>Cloud Data Platforms</li>
    <li>Data Governance</li>
    <li>Data Quality</li>
    <li>Business Intelligence</li>
    <li>Advanced Analytics</li>
    <li>AI Enablement</li>
  </ul>

  <h2>Contact</h2>

  <ul>
    <li>LinkedIn: <a href={AUTHOR.linkedin}>Giancarlo Ronci</a></li>
    <li>GitHub: <a href={AUTHOR.github}>GiancarloRonci</a></li>
    <li>Articles: <a href="/posts/">Posts</a></li>
    <!-- Riattivare quando il PDF è in public/assets/files/
    <li>CV: <a href="/assets/files/Giancarlo_Ronci_CV.pdf">Download CV</a></li>
    -->
  </ul>
</ProfileLayout>
