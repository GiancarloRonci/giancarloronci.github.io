---
import ProfileLayout from '../layouts/ProfileLayout.astro';
import CareerList from '../components/CareerList.astro';
import PostList from '../components/PostList.astro';
import { AUTHOR } from '../consts';
import { CV } from '../data/cv';
import { getPublishedPosts } from '../lib/posts';

const cv = CV.en;
const latestPosts = (await getPublishedPosts('en')).slice(0, 5);
---

<ProfileLayout>
  <h1>Giancarlo Ronci</h1>

  <p>Italy · Milan / Rome area</p>

  <p>
    For coaching, advisory, speaking or exchanges on Data, Analytics and AI, feel free to reach out on
    <a href={AUTHOR.linkedin}>LinkedIn</a>.
  </p>

  <h2>Bio</h2>

  <p>
    Giancarlo Ronci is a senior data leader and advisor with extensive experience in data management, data
    warehousing, analytics engineering and modern cloud data platforms.
  </p>
  <p>
    He works at the intersection of business, architecture and delivery, helping organizations turn data into
    concrete operating capabilities. His background combines hands-on experience in data warehouse design,
    streaming and batch pipelines, data governance, data quality and analytics enablement.
  </p>
  <p>
    His approach is pragmatic: connect strategy, operating model, architecture and execution to generate measurable
    business value.
  </p>

  <h2>Main areas of activity</h2>

  <ul>
    <li>Building and evolving modern data platforms</li>
    <li>Defining pragmatic Data Strategy and operating models</li>
    <li>Improving Data Governance and Data Quality capabilities</li>
    <li>Enabling Business Intelligence, Advanced Analytics and AI adoption</li>
    <li>Coaching professionals and teams on Data &amp; Analytics leadership</li>
  </ul>

  <h2>Professional Career</h2>

  <CareerList entries={cv.experience} />

  <h2>Education</h2>

  <CareerList entries={cv.education} />

  <p><a href="/cv/">See the full CV →</a></p>

  <h2>Selected Articles</h2>

  <p>A selection of articles and reflections on data platforms, governance, analytics strategy and AI adoption.</p>

  {
    latestPosts.length > 0 ? (
      <PostList posts={latestPosts} />
    ) : (
      <ul>
        <li>Modern Data Platform: from architecture to operating model</li>
        <li>Data Warehouse, Data Lake and Lakehouse: when each one makes sense</li>
        <li>Data Governance in practice: how to move from theory to execution</li>
        <li>Near real-time analytics: opportunities, trade-offs and architecture choices</li>
        <li>AI adoption in organizations: where value is real and where it is not</li>
      </ul>
    )
  }

  <p>You can find more articles in the <a href="/posts/">Articles</a> section.</p>

  <h2>Core expertise</h2>

  <ul>
    {cv.skills.map((skill) => <li>{skill}</li>)}
  </ul>

  <h2>Contact</h2>

  <ul>
    <li>LinkedIn: <a href={AUTHOR.linkedin}>Giancarlo Ronci</a></li>
    <li>GitHub: <a href={AUTHOR.github}>GiancarloRonci</a></li>
    <li>Articles: <a href="/posts/">Posts</a></li>
    <li>CV: <a href="/cv/">Curriculum Vitae</a></li>
  </ul>
</ProfileLayout>
