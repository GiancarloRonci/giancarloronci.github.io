---
import CategoryPage from '../../../../components/CategoryPage.astro';
import { getUsedCategories } from '../../../../lib/posts';

export async function getStaticPaths() {
  const categories = await getUsedCategories('it');
  return categories.map((category) => ({ params: { category: category.slug }, props: { slug: category.slug } }));
}

const { slug } = Astro.props;
---

<CategoryPage slug={slug} lang="it" />
