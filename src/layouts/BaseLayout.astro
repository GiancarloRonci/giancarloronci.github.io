---
import '../styles/global.css';
import { NAVIGATION, SITE_TITLE } from '../consts';
import { DEFAULT_LANG, getLang, LANGUAGES, localizePath, translatePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  // Indirizzo della stessa pagina nelle altre lingue, quando non è il semplice cambio di prefisso
  // (es. un articolo che ha un nome diverso o non è tradotto)
  alternates?: Partial<Record<Lang, string>>;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { title, description = t.description, alternates = {} } = Astro.props;

const pageTitle = title ? `${title} | ${SITE_TITLE}` : `${SITE_TITLE} · ${t.tagline}`;
const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, Astro.site);

const languageUrls = Object.fromEntries(
  (Object.keys(LANGUAGES) as Lang[]).map((code) => [
    code,
    code === lang ? currentPath : (alternates[code] ?? translatePath(currentPath, code)),
  ]),
) as Record<Lang, string>;
const otherLanguages = (Object.keys(LANGUAGES) as Lang[]).filter((code) => code !== lang);

const homePath = localizePath('/', lang);
const isActive = (url: string) => (url === homePath ? currentPath === homePath : currentPath.startsWith(url));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      Object.entries(languageUrls).map(([code, url]) => (
        <link rel="alternate" hreflang={code} href={new URL(url, Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(languageUrls[DEFAULT_LANG], Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={localizePath('/rss.xml', lang)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.dateLocale.replace('-', '_')} />
  </head>
  <body>
    <header class="masthead">
      <div class="masthead__inner">
        <a class="masthead__title" href={homePath}>{t.tagline}</a>
        <nav aria-label={t.navLabel}>
          <ul class="masthead__menu">
            {
              NAVIGATION.map((item) => {
                const url = localizePath(item.path, lang);
                return (
                  <li>
                    <a href={url} aria-current={isActive(url) ? 'page' : undefined}>
                      {t.nav[item.key]}
                    </a>
                  </li>
                );
              })
            }
            {
              otherLanguages.map((code) => (
                <li class="masthead__lang">
                  <a href={languageUrls[code]} hreflang={code} lang={code} title={useTranslations(code).switchTo}>
                    {code.toUpperCase()}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        © {new Date().getFullYear()} {SITE_TITLE} · <a href={localizePath('/rss.xml', lang)}>{t.rss}</a>
      </div>
    </footer>
  </body>
</html>
